# --- 2. データ解析関数 ---
def analyze_blood_data_form(data):
    """
    フォームから入力された血液データを分析し、結果をMarkdown形式で返します。
    """
    results = []
    abnormal_items = []

    for item_key, value in data.items():
        if value is None: # 入力がない場合はスキップ
            continue

        if item_key in BLOOD_ITEMS_INFO:
            info = BLOOD_ITEMS_INFO[item_key]
            item_name = info["name"]
            min_val = info["min"]
            max_val = info["max"]
            unit = info["unit"]

            status = "正常"
            possible_causes = ""

            if value < min_val:
                status = "**低値**"
                if info["low"]:
                    possible_causes = f"*   可能性: {info['low']}\n"
                abnormal_items.append(item_name)
            elif value > max_val:
                status = "**高値**"
                if info["high"]:
                    possible_causes = f"*   可能性: {info['high']}\n"
                abnormal_items.append(item_name)

            result_text = f"**【{item_name} ({item_key})】**\n"
            result_text += f"*   測定値: {value} {unit}\n"
            result_text += f"*   基準値: {min_val} - {max_val} {unit}\n"
            result_text += f"*   判定: {status}\n"
            result_text += f"*   説明: {info['desc']}\n"
            result_text += possible_causes

            results.append(result_text)
        else:
            # 基本的にBLOOD_ITEMS_INFOにない項目は来ない想定だが、念のため
            results.append(f"**【不明な項目】**\n*   項目名: {item_key}\n*   測定値: {value}\n*   この項目は分析できませんでした。")

    summary = "\n---\n**【全体サマリー】**\n"
    if abnormal_items:
        summary += f"入力されたデータでは、**{', '.join(abnormal_items)}** が基準値から外れています。\n"
    else:
        summary += "全ての項目が基準値内でした。\n"

    summary += "\n**【重要なお知らせ】**\n"
    summary += "この情報はあくまで一般的な参考情報であり、医療行為ではありません。診断や治療の代わりにはなりません。\n"
    summary += "ご自身の健康状態についてご心配な場合は、必ず医師にご相談ください。\n"

    return "\n\n".join(results) + summary

